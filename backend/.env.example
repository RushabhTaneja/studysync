# --- Server ---
PORT=4000
NODE_ENV=development
# Public base URL of THIS backend (used for OAuth redirect URIs). For local dev keep as-is.
BACKEND_BASE_URL=http://localhost:4000
# Where the frontend runs (used for redirects + CORS).
FRONTEND_BASE_URL=http://localhost:5173

# --- Auth ---
# Secret for signing StudySync account JWTs. Change in production.
JWT_SECRET=dev-only-change-me

# --- TimescaleDB ---
# Connection string from Timescale Cloud (or any Postgres+TimescaleDB).
# e.g. postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
DATABASE_URL=

# --- Dexcom CGM (sandbox) ---
# Register an app at https://developer.dexcom.com to obtain these.
# Redirect URI registered with Dexcom must be: ${BACKEND_BASE_URL}/api/connect/dexcom/callback
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
DEXCOM_BASE_URL=https://sandbox-api.dexcom.com

# --- SMART-on-FHIR (sandbox) ---
# Public sandbox; no registration needed. Standalone launch against SMART Health IT.
# This is a public client (PKCE, no secret).
SMART_FHIR_ISS=https://launch.smarthealthit.org/v/r4/fhir
SMART_CLIENT_ID=studysync-web

# --- Insights chat (optional, build last) ---
ANTHROPIC_API_KEY=
